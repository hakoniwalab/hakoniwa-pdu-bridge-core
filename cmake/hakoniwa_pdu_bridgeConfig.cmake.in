@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Bridge's installed public library depends on the Endpoint package contract.
# Endpoint itself resolves Boost/nlohmann and, when applicable, Hakoniwa Core.
find_dependency(hakoniwa_pdu_endpoint CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/hakoniwa_pdu_bridgeTargets.cmake")

# New consumers should use hakoniwa_pdu_bridge::bridge.  Keep the historical
# exported name as a compatibility alias because existing consumers such as
# hakoniwa-conductor-pro already probe for it.
if(TARGET hakoniwa_pdu_bridge::bridge
   AND NOT TARGET hakoniwa_pdu_bridge::hakoniwa_pdu_bridge_lib)
  add_library(hakoniwa_pdu_bridge::hakoniwa_pdu_bridge_lib ALIAS
              hakoniwa_pdu_bridge::bridge)
endif()
